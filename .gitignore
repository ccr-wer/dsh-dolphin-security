# ===== Dolphin 忽略规则 =====

# 依赖
node_modules/

# 扫描报告（可能包含扫描结果与临时敏感数据，绝不入库）
reports/

# 日志
*.log

# 测试脚本（本地保留，不随开源仓库发布）
test-ssh-hosts.js

# 本地开发工作脚本（规则集构建/审计/合并/同步等一次性工具，
# 内含本机绝对路径引用，不随开源仓库发布）
staging/

# 锁文件（库项目按惯例不提交，由使用方自行生成）
package-lock.json

# 打包产物
*.tgz
# npm 发布包的解压快照（0.2.5 归档副本，与 *.tgz 同类；不参与分发，也不再随仓库维护）
npm-dist/

# 参考用的第三方源码（已完成历史使命；许可文本见 THIRD_PARTY_LICENSES/）
dsh-web/
dsh-plugin-hos-forge-v2/

# 上架用 Skill 封装包：已独立成库（github.com/ccr-wer/dolphin-security-skill）
# 内含嵌套 git 仓库，父仓库若 add 会退化成 gitlink，故整体排除
skill-package/

# 内部开发日志（仅供本地留存，绝不入库/不上传 npm）
*_DEVLOG.md

# macOS
.DS_Store

# 环境变量与密钥（安全底线，绝不入库）
.env
.env.*
*.pem
*.key
*.p12

# 个人知识库/密钥资产目录（防止任何意外操作导致密钥泄露）
# 本机存放 API Key 的 .env 即位于此类目录下，故整体排除，永不入库
MyKnowledge/
**/DeepSeek Tess/
**/项目资产/
